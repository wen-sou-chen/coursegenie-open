# ===== CourseGenie 环境变量示例 =====
# 复制为 .env 后按需修改（backend 目录下运行）

# --- 数据库 ---
# 默认 SQLite（零配置）；切 PostgreSQL 时取消注释并安装 psycopg2-binary
# DATABASE_URL=postgresql+psycopg://coursegenie:coursegenie@localhost:5432/coursegenie

# --- LLM（必须二选一；不配则用 mock 生成器，可跑通但内容为占位） ---
LLM_PROVIDER=mock                # openai | anthropic | mock
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek 官方直连：OPENAI_BASE_URL=https://api.deepseek.com，并建议 OPENAI_DISABLE_THINKING=true
# OPENAI_DISABLE_THINKING=false
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENROUTER_API_KEY=sk-or-v1-...      # openrouter | 一个 key 路由多模型
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 图像生成（可选） ---
IMAGE_PROVIDER=mock              # openai | stability | openrouter | mock
# IMAGE_MODEL=google/gemini-2.5-flash-image   # openrouter 图像模型（默认 gemini-2.5-flash-image）
# STABILITY_API_KEY=...

# --- 认证（默认关闭，单机本机使用可接受） ---
# 开启前务必设置非默认 DEV_API_KEY，否则应用会拒绝启动：
# AUTH_ENABLED=true
# DEV_API_KEY=请换成随机长字符串
# 注意：本项目暂无多用户租户隔离；关闭认证时请把服务绑定在 127.0.0.1，
# 不要绑定 0.0.0.0 暴露到局域网。X-API-Key 由注册接口 /api/auth/register 签发。
AUTH_ENABLED=false
# DEV_API_KEY=dev-key-change-me

# --- dashi-ppt 集成（可选；不配置则用 python-pptx 兜底） ---
# DASHI_PPT_PROJECT_ROOT=C:/Users/wen/_dashi_ppt_review/skills/dashi-ppt/project
# DASHI_PPT_FORCE_FALLBACK=false

# --- 笔记系统导出目标（默认 backend/storage/kb；课程可单独覆盖） ---
# 例：OBSIDIAN_VAULT_ROOT=D:/包子知识库
# OBSIDIAN_VAULT_ROOT=

# --- 上传限制 ---
# MAX_UPLOAD_MB=50          # 素材/图片/PPT 上传大小上限（MB，默认 50）

# --- 单租户演示模式（任务 154；默认关闭） ---
# DEMO_ONLY=true 时：注册/登录 403；每 IP 每分钟 6 次生成、滚动 24h 最多 5 门课、
# 同时只跑 1 个生成任务；课程/素材/导出/课件/演示 vault 24h 后自动清理。
# ⚠️ OBSIDIAN_VAULT_ROOT 指向真实笔记库时不要开 DEMO_ONLY（会按保留期删除课程子目录）。
# DEMO_ONLY=false
# DEMO_RETENTION_HOURS=24
# DEMO_MAX_GENERATIONS_PER_MINUTE=6
# DEMO_MAX_COURSES_PER_DAY=5
# DEMO_MAX_CONCURRENT_JOBS=1
# DEMO_TRUST_PROXY_HEADERS=true   # Cloudflare/Nginx 可信反代后为 true；直接暴露公网设 false

# --- 前端托管（任务 115：让别人「只起一个进程」就能用整个应用） ---
# 默认开：后端把 frontend/dist 托管在根路径（http://127.0.0.1:8000/），
# 非 /api/* 的 GET 走 SPA 回退（/share/<token> 这类深链刷新不 404）。
# SERVE_FRONTEND=false      # 关掉 = 纯 API 行为（Docker 里前端由 nginx 单独跑时用）
# FRONTEND_DIST_DIR=D:/path/to/frontend/dist   # 前端产物不在仓库默认位置时指定；
#                            # 留空则自动找 <仓库>/frontend/dist 与 ./frontend/dist

# --- 语音转写（可选依赖 requirements-asr.txt；不装则音视频素材只入库、不转写） ---
# ASR_MODEL=small           # small 快但中文易错；medium / large-v3 更准更慢（同段中文实测约 3× 耗时）

# --- 从链接导入（任务 118 / 119：粘贴 YouTube 视频 / 播放列表链接 → 课程素材；可选依赖） ---
# 只影响「素材页 → 从链接导入」这一个入口：缺依赖时界面会说清「缺什么 / 影响什么 / 怎么装」，
# 其它功能（上传 / 粘贴 / 生成 / 交付）一律照常。抓取顺序**写死**：① 抓字幕 → ② 没字幕才下音频走本机 ASR。
# 下面三项：**进程环境变量与这个 `.env` 都能覆盖，进程环境变量优先**（与 ASR_MODEL 同款回落链）。
# YTDLP_EXE=C:/Users/me/tools/yt-dlp.exe        # yt-dlp 可执行文件路径（路径含空格时必须用这个写法）
# YTDLP_CMD=python -m yt_dlp                   # 或给整条命令（pip 装的用这条）；**优先级高于 YTDLP_EXE**
# YTDLP_COOKIES=C:/Users/me/tools/cookies.txt  # YouTube 常要求登录态；cookie 必须是 .youtube.com 域
# 三项都不写 ⇒ 回落 PATH 上的 yt-dlp 与常见落地位置（~/.local/bin、~/bin）。
#   ⛔ 本项目只把「路径」交给 yt-dlp：不复制、不进日志、不进接口返回、不写进库；
#      cookie 会过期，失效时的报错会被翻成「像是登录态问题」的人话（界面直接显示，见 docs/task118-link-import.md）

# --- 使用说明（网页端是唯一编辑源） ---
# 素材（原始资料）：POST /api/material/upload|paste（.docx/.pdf/.pptx/.md/.txt/.csv）
#                    POST /api/material/import-link（从链接导入 YouTube；重试 POST /api/material/{id}/import-link）
# 生成笔记系统：POST /api/kb/course/{course_id}/export?force=（防覆盖：手动改过的文件会跳过）
# 图片：POST /api/image/generate（item_id 时原地重做）/ POST /api/image/import（上传自己的图）
# 流程图：POST /api/flowchart/generate / POST /api/flowchart/import（粘贴自绘 Mermaid）
# PPT：POST /api/ppt/generate / POST /api/ppt/import（上传自己的 PPTX）
# 通用内容项：PATCH|DELETE /api/content/{item_id}；大纲节点：PATCH /api/plan/node/{node_id}
# 习题：PATCH|DELETE /api/quiz/{quiz_id}
