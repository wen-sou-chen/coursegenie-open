{
  "mcpServers": {
    "coursegenie": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "coursegenie-mcp==1.0.5",
        "coursegenie-mcp"
      ],
      "env": {
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
        "COURSE_BACKEND_URL": "${COURSE_BACKEND_URL}"
      },
      "timeout": 30000
    }
  }
}
